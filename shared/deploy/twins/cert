#!/usr/bin/env bash
# Signs an SSH certificate for a person of the seed, as ADR 0002 decides,
# and prints the key to set as JJFORGE_KEY, such as
# `cert acme_member`. Without a person, it only makes the authority.
#
# One certificate authority signs for every organization of the seed, as the
# server will once it signs people in (#6). Its key lives in
# shared/deploy/.dev/, made on first use and never committed.
set -euo pipefail

dev=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.dev
mkdir -p "$dev/people"
chmod 700 "$dev" "$dev/people"

# The organizations of the seed, by ID.
acme=0199c9a0-0000-7000-8000-00000000ac3e
other=0199c9a0-0000-7000-8000-0000000007e2

[[ -f $dev/authority ]] || ssh-keygen -q -t ed25519 -N '' -C "jjforge dev authority" -f "$dev/authority"

person=${1:-}
[[ -n $person ]] || exit 0

# The scopes of each person of the seed, as shared/docs/specs/29-push-and-clone.md
# names them.
case $person in
  acme_owner) scope="sync:write:$acme sync:admin:$acme" ;;
  acme_member) scope="sync:write:$acme" ;;
  other_owner) scope="sync:write:$other sync:admin:$other" ;;
  server) scope="sync:admin:$acme sync:admin:$other sync:read:$acme sync:read:$other" ;;
  *)
    echo "cert: $person is no person of the seed" >&2
    exit 2
    ;;
esac

key=$dev/people/$person
[[ -f $key ]] || ssh-keygen -q -t ed25519 -N '' -C "$person" -f "$key"
# The server reads its key as the container's own user, never as the owner
# of the file. A dev key guards nothing real.
[[ $person != server ]] || chmod 644 "$key"
ssh-keygen -q -s "$dev/authority" -I "$person" -n "$person" -V -5m:+12h \
  -O clear -O "extension:jjforge-scope@nca-apprentices.dev=$scope" "$key.pub"
echo "$key"
