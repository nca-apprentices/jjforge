#!/usr/bin/env bash
#MISE description="Check that the agent instructions name only paths, tasks, skills, and agents that exist"
set -euo pipefail

# Each match of a pattern in the files an agent reads as instructions, as
# "file:match". Further arguments go to rg.
matches() {
  git ls-files -z --cached --others --exclude-standard AGENTS.md '.claude/*.md' |
    xargs -0 rg -o --with-filename "$@" | sort -u
}

errors=0
fail() {
  echo "error: $*" >&2
  errors=$((errors + 1))
}

# A path in backticks, such as `shared/http/pending/`. A placeholder such as
# `<module>`, a glob, or a URL isn't a path. A generated path, which
# .gitignore lists, may not exist yet. The backticks are rg's, not bash's.
# shellcheck disable=SC2016
while IFS=: read -r file path; do
  if [[ ! -e $path ]] && ! git check-ignore -q "$path"; then
    fail "$file names $path, which doesn't exist"
  fi
done < <(matches '`(\.?[A-Za-z0-9_][^`<>{}* :]*/[^`<>{}* :]*)`' -r "\$1")

# A task, such as `mise run spec:trace`, is the file spec/trace.
while IFS=: read -r file task; do
  if [[ ! -f shared/config/mise/tasks/${task//://} ]]; then
    fail "$file names mise run $task, which doesn't exist"
  fi
done < <(matches 'mise run ([a-z][a-z:-]*)' -r "\$1")

# A skill or an agent, such as /jjforge-specify or jjforge-spec-reviewer.
while IFS=: read -r file name; do
  if [[ ! -f .claude/skills/$name/SKILL.md && ! -f .claude/agents/$name.md ]]; then
    fail "$file names $name, which is no skill or agent"
  fi
done < <(matches 'jjforge-[a-z]+(-[a-z]+)*')

if ((errors > 0)); then
  exit 1
fi
