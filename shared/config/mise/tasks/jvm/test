#!/usr/bin/env bash
#MISE description="Run the gradle build: tests, detekt, architecture, and coverage"
#MISE depends=["api:build"]
set -euo pipefail

# Testcontainers starts Postgres through the podman machine's
# Docker-compatible socket when one runs, and through Docker otherwise, as in
# CI. Ryuk, which removes the containers, mounts the socket inside the machine.
if [[ -z ${DOCKER_HOST:-} ]] && socket=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null); then
  export DOCKER_HOST=unix://$socket
  export TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/run/podman/podman.sock
fi

gradle -p jvm build
