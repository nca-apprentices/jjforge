#!/usr/bin/env bash
#MISE description="Run the server on :8080 against the twins of `mise run twins` and vcs on :50052"
#MISE depends=["api:build"]
set -euo pipefail

# The server migrates the database itself at startup, without the migration
# Job of compose and the chart.
export SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:${JJFORGE_POSTGRES_PORT:-5432}/postgres
export SPRING_DATASOURCE_USERNAME=postgres
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:${JJFORGE_TRACES_PORT:-10428}/insert/opentelemetry/v1/traces
# The server's own dev certificate, which opens its session with vcs.
JJFORGE_VCS_CREDENTIAL_KEY=$(shared/deploy/twins/cert server)
export JJFORGE_VCS_CREDENTIAL_KEY

exec gradle -p jvm bootRun
