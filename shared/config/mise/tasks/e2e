#!/usr/bin/env bash
#MISE description="Run the end-to-end scenarios in shared/e2e/ against a running `mise run up`"
set -euo pipefail

# REST: the requests in shared/e2e/http/, with their asserts. `run` makes the
# names a scenario creates unique, so the suite runs twice on one server.
server="http://localhost:${JJFORGE_PORT:-8080}"
run=$(date +%s)
# shellcheck disable=SC2329 # check calls it.
hurl_run() {
  hurl --test --variable server="$server" --variable run="$run" \
    --variables-file shared/e2e/http/vars.env "$@"
}

# CLI: the scenarios in shared/e2e/cli/ run the first jf on PATH, so they test
# a release as well as this tree. JF_BIN names a jf already built, as CI does.
# Without it, the task builds this tree's.
if [[ -z ${JF_BIN:-} ]]; then
  cargo build --manifest-path rust/Cargo.toml -q --bin jf
  JF_BIN=$PWD/rust/target/debug/jf
fi
# shellcheck disable=SC2329 # check calls it.
bats_run() {
  PATH="$(dirname "$JF_BIN"):$PATH" JJFORGE_ENDPOINT="$server" bats "$@"
}

# A scenario with the line `# pending` waits for its build PR, as ADR 0004
# decides, and must fail until then. One that passes fails the run, so the
# build PR removes the line. The others must pass.
status=0
check() {
  local runner=$1 file
  local ready=()
  shift
  for file in "$@"; do
    if ! grep -qx '# pending' "$file"; then
      ready+=("$file")
      continue
    fi
    if "$runner" "$file" >/dev/null 2>&1; then
      echo "$file passes: remove its '# pending' line"
      status=1
      continue
    fi
    echo "$file is pending"
  done
  if ((${#ready[@]})); then
    "$runner" "${ready[@]}" || status=1
  fi
}

check hurl_run shared/e2e/http/*.hurl
check bats_run shared/e2e/cli/*.bats

# Telemetry: the trace of a request, from the twin of the trace store that
# `mise run up` starts. Another server has no twin to ask, so this runs here
# only.
traces="http://localhost:${JJFORGE_TRACES_PORT:-10428}"
hurl --test --variable server="$server" --variable traces="$traces" \
  --variable trace="$(openssl rand -hex 16)" shared/e2e/traces/*.hurl || status=1
exit "$status"
