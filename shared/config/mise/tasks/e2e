#!/usr/bin/env bash
#MISE description="Run the end-to-end scenarios in shared/e2e/ against a running `mise run up`"
set -euo pipefail

# REST: the requests in shared/e2e/http/, with their asserts. `run` makes the
# names a scenario creates unique, so the suite runs twice on one server.
server="http://localhost:${JJFORGE_PORT:-8080}"
run=$(date +%s)
hurl --test --variable server="$server" --variable run="$run" shared/e2e/http/*.hurl

# The pending scenarios, whose operations still answer 501. They report and
# never fail: the PR that builds a requirement moves its file up, as ADR 0009
# decides.
if compgen -G 'shared/e2e/http/pending/*.hurl' >/dev/null; then
  echo "pending scenarios, expected to fail until their operations are built:"
  hurl --test --variable server="$server" --variable run="$run" \
    --variables-file shared/e2e/http/pending/vars.env shared/e2e/http/pending/*.hurl || true
fi

# CLI: the scenarios in shared/e2e/cli/ run the first jf on PATH, so they test
# a release as well as this tree. JF_BIN names a jf already built, as CI does.
# Without it, the task builds this tree's.
if [[ -z ${JF_BIN:-} ]]; then
  cargo build --manifest-path rust/Cargo.toml -q --bin jf
  JF_BIN=$PWD/rust/target/debug/jf
fi
PATH="$(dirname "$JF_BIN"):$PATH" JJFORGE_ENDPOINT="$server" bats shared/e2e/cli

# The pending CLI scenarios, like the pending REST ones.
if compgen -G 'shared/e2e/cli/pending/*.bats' >/dev/null; then
  echo "pending CLI scenarios, expected to fail until their commands are built:"
  PATH="$(dirname "$JF_BIN"):$PATH" JJFORGE_ENDPOINT="$server" bats shared/e2e/cli/pending || true
fi
