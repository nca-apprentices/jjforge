#!/usr/bin/env bash
#MISE description="Send one echo through every component of a running `mise run up`"
set -euo pipefail

# Web and REST: the requests in shared/http/, with their asserts. `run` makes
# the names a scenario creates unique, so the suite runs twice on one server.
server="http://localhost:${JJFORGE_PORT:-8080}"
run=$(date +%s)
hurl --test --variable server="$server" --variable run="$run" shared/http/*.hurl

# The pending scenarios, whose operations still answer 501. They report and
# never fail: the PR that builds an operation moves its file up, as ADR 0017
# decides.
if compgen -G 'shared/http/pending/*.hurl' >/dev/null; then
  echo "pending scenarios, expected to fail until their operations are built:"
  hurl --test --variable server="$server" --variable run="$run" \
    --variables-file shared/http/pending/vars.env shared/http/pending/*.hurl || true
fi

# The jf CLI, through the same REST API.
answer=$(JJFORGE_ENDPOINT="http://localhost:${JJFORGE_PORT:-8080}" cargo run --manifest-path rust/Cargo.toml -q --bin jf -- echo smoke)
if [[ $answer != smoke ]]; then
  echo "cli: got '$answer'" >&2
  exit 1
fi

echo "web, server, vcs and cli answered"
