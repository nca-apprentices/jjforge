#!/usr/bin/env bash
#MISE description="Send one echo through every component of a running `mise run up`"
set -euo pipefail

# Web and REST: the requests in shared/http/, with their asserts.
hurl --test --variable server="http://localhost:${JJFORGE_PORT:-8080}" shared/http/*.hurl

# gRPC, which hurl cannot send: the jjforge CLI against vcsd.
answer=$(JJFORGE_ENDPOINT=http://localhost:50052 cargo run --manifest-path rust/Cargo.toml -q --bin jjforge -- echo smoke)
if [[ $answer != smoke ]]; then
  echo "cli: got '$answer'" >&2
  exit 1
fi

echo "web, server, vcsd and cli answered"
