#!/usr/bin/env bash
#MISE description="Fail on a breaking change to the REST contract against a git ref, origin/main by default"
#MISE depends=["api:build"]
#USAGE arg "[base]" default="origin/main"
set -euo pipefail

# The bundled file isn't committed, so the base ref's contract is bundled
# into a scratch directory.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
git archive "${usage_base:?}" shared/api | tar -x -C "$scratch"

# The YAML contract is the first baseline. A base from before it has
# nothing to compare.
if [[ ! -f $scratch/shared/api/openapi.yaml ]]; then
  echo "${usage_base} has no shared/api/openapi.yaml, so nothing to compare."
  exit 0
fi

export REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true
pnpm --dir shared/api exec redocly bundle "$scratch/shared/api/openapi.yaml" --output "$scratch/openapi.yaml"

oasdiff breaking "$scratch/openapi.yaml" shared/openapi.yaml --fail-on ERR
