#!/usr/bin/env bash
#MISE description="Map each Requirement issue to the specs, tests, and designs that cite it"
#MISE depends=["spec:build"]
set -euo pipefail

# One line per operation: its method, its operationId, then the issues it
# cites, such as "get listChanges #35 #38". The echo skeleton is exempt until
# it is removed.
repo=${GITHUB_REPOSITORY:-nca-apprentices/jjforge}
operations=$(yq -r '
  .paths[] | to_entries[] | select(.value | has("operationId"))
  | select(.value.tags[0] != "echo")
  | .key + " " + .value.operationId + " " + ((.value["x-requirements"] // []) | join(" "))
' shared/openapi.yaml)

# A write operation, so any method but GET, needs a design once its
# requirement is done.
writes=$(awk '$1 != "get" { print $2 }' <<<"$operations")

# Errors print after the table, so they don't break it up.
errors=""
fail() {
  errors+="error: $*"$'\n'
}

while read -r _ operation issues; do
  if [[ -z $issues ]]; then
    fail "$operation cites no requirement in x-requirements"
  fi
done <<<"$operations"

# One line per citation: the issue, then what cites it, such as
# "#35 listChanges", "#35 rust/cli/tests/log.rs", or
# "#25 shared/docs/design/E10-orgs-and-repos.md". A test file cites its
# requirements on a line such as "satisfies #35 #38", and a design section on
# a line such as "designs #25 #26".
citations=$(
  while read -r _ operation issues; do
    for issue in $issues; do
      echo "$issue $operation"
    done
  done <<<"$operations"

  {
    grep -rEo --exclude='*.md' 'satisfies( #[0-9]+)+' rust server web shared/http || true
    grep -rEo 'designs( #[0-9]+)+' shared/docs/design || true
  } |
    while IFS=: read -r file match; do
      for issue in ${match#* }; do
        echo "$issue $file"
      done
    done
)

# Every issue as "number<TAB>state<TAB>type<TAB>title", in one paginated call.
issues=$(gh api --paginate "repos/$repo/issues?state=all&per_page=100" \
  --jq '.[] | select(.pull_request | not) | "\(.number)\t\(.state)\t\(.type.name // "untyped")\t\(.title)"')

# A citation must name a Requirement.
while read -r issue; do
  type=$(awk -F'\t' -v n="${issue#\#}" '$1 == n { print $3 }' <<<"$issues")
  if [[ $type != Requirement ]]; then
    by=$(awk -v i="$issue" '$1 == i { print $2 }' <<<"$citations" | sort -u | paste -sd, - | sed 's/,/, /g')
    fail "$issue is ${type:-missing}, not a Requirement, cited by $by"
  fi
done < <(awk 'NF { print $1 }' <<<"$citations" | sort -u)

# One entry per Requirement in build/trace.yaml, in ID order, such as
# "R020: {issue: 35, state: open, title: ..., cited_by: [listChanges]}". A
# closed requirement counts as done, so it must be cited, and by a design too
# when an operation writes for it.
trace=build/trace.yaml
mkdir -p build
echo "# Generated by mise run spec:trace. Don't edit." >"$trace"
total=0
uncited=()
while IFS=$'\t' read -r number state _ title; do
  by=$(awk -v i="#$number" '$1 == i { print $2 }' <<<"$citations" | sort -u | paste -sd, -)
  total=$((total + 1))
  if [[ -z $by ]]; then
    uncited+=("${title%% *}")
  fi
  if [[ -z $by && $state == closed ]]; then
    fail "#$number is closed, but nothing cites it"
  fi

  # A done requirement that an operation writes for has a design section.
  if [[ $state == closed && $by != *shared/docs/design/* ]]; then
    writer=$(awk -v i="#$number" '$1 == i { print $2 }' <<<"$citations" | grep -Fxf <(echo "$writes") | head -1 || true)
    if [[ -n $writer ]]; then
      fail "#$number is closed and $writer writes for it, but no design in shared/docs/design cites it"
    fi
  fi

  ID=${title%% *} NUMBER=$number STATE=$state TITLE=${title#* } BY=$by yq -n '
    .[strenv(ID)] = {
      "issue": env(NUMBER), "state": strenv(STATE), "title": strenv(TITLE),
      "cited_by": ((strenv(BY) | select(. != "") | split(",")) // [])
    }' >>"$trace"
done < <(awk -F'\t' '$3 == "Requirement"' <<<"$issues" | sort -t$'\t' -k4)

echo "$((total - ${#uncited[@]})) of $total requirements cited. See $trace."
if ((${#uncited[@]} > 0)); then
  echo "Uncited: ${uncited[*]}"
fi
if [[ -n $errors ]]; then
  printf '\n%s' "$errors" >&2
  exit 1
fi
