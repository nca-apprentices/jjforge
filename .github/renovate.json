{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Zurich",
  "schedule": ["* 0-5 1,15 * *"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 1,15 * *"]
  },
  "packageRules": [
    {
      "description": "Cargo.toml names the exact version in use, and Cargo.lock pins it.",
      "matchManagers": ["cargo"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Everything arrives as one PR per schedule window. Files that must agree, such as rust-toolchain.toml, mise.toml, and the vcs image, update together.",
      "matchPackageNames": ["*"],
      "groupName": "dependencies",
      "separateMajorMinor": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "dprint plugins from npm. The exec plugin carries a checksum, so `dprint config update` updates it instead.",
      "managerFilePatterns": ["/^shared/config/dprint\\.json$/"],
      "matchStrings": [
        "\"npm:(?<depName>(@[^/\"]+/)?[^@\"]+)@(?<currentValue>[^\"/@]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
