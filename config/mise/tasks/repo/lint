#!/usr/bin/env bash
#MISE description="Check the contracts, workflows, Dockerfiles, task scripts, chart, formatting, prose, and links"
set -euo pipefail

buf lint contracts/proto
mise run api:lint

# ADR 0006: a list that vcs answers, in any message but a request and at any
# depth, sits beside a page token, or a comment that starts with `Bounded:`
# says why it stays small.
awk '
  /^message [A-Za-z0-9]+ \{/ { message = ($2 ~ /Request$/) ? "" : $2; token = 0; n = 0; bounded = 0; next }
  !message { next }
  /^ *\/\// { if (/Bounded:/) { bounded = 1 }; next }
  /next_page_token = / { token = 1 }
  /^ *repeated / && !bounded { lists[++n] = FILENAME ":" FNR ": " message " lists " $3 }
  /^}/ {
    if (!token) { for (i = 1; i <= n; i++) { print lists[i] " without a page token or a Bounded: comment"; failed = 1 } }
    message = ""
  }
  { bounded = 0 }
  END { exit failed }
' contracts/proto/source/v1/*.proto

# Workflows, Dockerfiles, task scripts, and CLI scenarios.
actionlint
hadolint --config config/hadolint.yaml platform/server/Dockerfile core/vcs/Dockerfile
find config/mise/tasks -type f -exec shellcheck {} +
find e2e/cli -name '*.bats' -exec shellcheck {} +

# The chart requires the secret a release names, so the checks name one.
helm lint deploy/chart --set server.database.secretName=jjforge-db-app
helm template jjforge deploy/chart --set server.database.secretName=jjforge-db-app >/dev/null

# The web formatter needs the web packages installed.
pnpm --dir platform/web install --frozen-lockfile
dprint check --config config/dprint.json
mise run prose

# Every relative link and anchor in the Markdown. Offline, so a remote site
# that is down never fails the check.
git ls-files -z --cached --others --exclude-standard '*.md' |
  xargs -0 lychee --offline --include-fragments --no-progress
