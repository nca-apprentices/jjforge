#!/usr/bin/env bash
#MISE description="Run the pinned Redocly CLI with config/redocly.yaml, such as `mise run api:redocly lint`"
set -euo pipefail

pnpm --dir contracts/openapi install --frozen-lockfile

# The binary runs from the repository root, so paths in the arguments resolve
# from there. `pnpm exec` would run it from contracts/openapi. A command
# that takes `--config` gets the repository's config unless the arguments
# name another, so `lint` becomes `lint --config config/redocly.yaml`.
args=("$@")
case ${1:-} in
# Preview watches its project directory, and the repository root holds more
# files than macOS lets one process watch.
preview)
  if [[ " $* " != *" -d "* && " $* " != *" --project-dir "* ]]; then
    args=(preview --project-dir contracts/openapi "${@:2}")
  fi
  ;;
"" | -* | logout | translate | eject | respect | generate-arazzo | completion) ;;
*)
  if [[ " $* " != *" --config "* ]]; then
    args=("$1" --config config/redocly.yaml "${@:2}")
  fi
  ;;
esac

export REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true
exec contracts/openapi/node_modules/.bin/redocly "${args[@]}"
