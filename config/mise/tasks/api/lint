#!/usr/bin/env bash
#MISE description="Lint the REST contract in contracts/openapi with Redocly"
#MISE depends=["api:build"]
set -euo pipefail

# Redocly reports usage and checks for updates unless told not to.
export REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true
pnpm --dir contracts/openapi exec redocly lint openapi.yaml --config ../../config/redocly.yaml
