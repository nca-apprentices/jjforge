#!/usr/bin/env bash
#MISE description="Delete build output, dependencies, generated files, and agent scratch files"
set -euo pipefail

# A fixed list instead of `git clean -X`, which would also delete ignored
# local state such as .idea/, .env, and .claude-notes/.
rm -rf \
  .pnpm-store \
  core/target \
  platform/server/build platform/server/.gradle \
  platform/server/src/main/resources/static \
  platform/web/app/dist \
  platform/web/shared/api/src/contract.gen.ts \
  contracts/openapi.yaml \
  site/dist site/.cache site/docs \
  config/vale/styles/Google \
  .rumdl_cache \
  .claude/tmp .claude/.cc-writes

find . \( -name .git -o -name .jj \) -prune -o \
  -type d -name node_modules -prune -exec rm -rf {} +
rm -f ./*.log
find . \( -name .git -o -name .jj \) -prune -o \
  -type f -name .DS_Store -exec rm -f {} +

# Show what clean keeps that Git doesn't track: ?? is untracked, !! is
# ignored.
echo "Not checked in:"
git status --short --ignored
