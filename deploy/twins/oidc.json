{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "acme",
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "acme-owner",
          "claims": {
            "sub": "${subject}",
            "aud": ["jjforge"],
            "email": "${subject}@acme.example",
            "preferred_username": "${subject}",
            "scope": "sync:write:0199c9a0-0000-7000-8000-00000000ac3e sync:admin:0199c9a0-0000-7000-8000-00000000ac3e"
          }
        },
        {
          "requestParam": "subject",
          "match": "acme-member",
          "claims": {
            "sub": "${subject}",
            "aud": ["jjforge"],
            "email": "${subject}@acme.example",
            "preferred_username": "${subject}",
            "scope": "sync:write:0199c9a0-0000-7000-8000-00000000ac3e"
          }
        }
      ]
    },
    {
      "issuerId": "other",
      "requestMappings": [
        {
          "requestParam": "subject",
          "match": "other-owner",
          "claims": {
            "sub": "${subject}",
            "aud": ["jjforge"],
            "email": "${subject}@other.example",
            "preferred_username": "${subject}",
            "scope": "sync:write:0199c9a0-0000-7000-8000-0000000007e2 sync:admin:0199c9a0-0000-7000-8000-0000000007e2"
          }
        }
      ]
    }
  ]
}
