{
  "name": "jjforge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm check && pnpm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.6.0"
}
