{
  "name": "jjforge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm check && pnpm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0"
}
