{
  "name": "jjforge-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm generate && pnpm --filter @jjforge/web build",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "dev": "pnpm --filter @jjforge/web dev",
    "generate": "pnpm --filter @jjforge/api generate",
    "test": "pnpm generate && vitest run",
    "typecheck": "pnpm generate && tsc --noEmit",
    "validate": "pnpm typecheck && pnpm check && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.6.0"
}
