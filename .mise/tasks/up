#!/usr/bin/env bash
#MISE description="Build the images and run server, vcs, and the web app with podman, such as `mise run up --detach`"
set -euo pipefail

# podman builds the images itself. Compose's own builder goes through the
# Docker API, which needs BuildKit and Docker's credential helpers. Compose then
# finds the images locally under the names in deploy/compose.yaml and
# pulls nothing.
podman build --tag ghcr.io/nca-apprentices/jjforge-server:latest --file platform/server/Dockerfile .
podman build --tag ghcr.io/nca-apprentices/jjforge-vcs:latest --file core/vcs/Dockerfile .
podman build --tag ghcr.io/nca-apprentices/jjforge-web:latest --file platform/web/app/Dockerfile .

# JJFORGE_PORT moves the web app off 8080 when something else holds it.
exec mise run compose up "$@"
